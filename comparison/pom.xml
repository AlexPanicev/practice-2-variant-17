<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>coursework.demo</groupId>
  <artifactId>maven-consumer</artifactId>
  <version>1</version>

  <repositories>
    <repository>
      <id>analysis-source</id>
      <url>${compare.repository}</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>${compare.group}</groupId>
      <artifactId>${compare.artifact}</artifactId>
      <version>${compare.version}</version>
    </dependency>
  </dependencies>

  <build>
    <directory>${compare.output}/target</directory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions>
          <execution>
            <id>runtime-classpath</id>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputFile>${compare.output}/classpath.txt</outputFile>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
